{%- set orgId = site.url + "/#organization" -%}
{%- set websiteId = site.url + "/#website" -%}
{%- set pageUrl = site.url + page.url -%}
{%- set pageId = pageUrl + "#webpage" -%}
{%- set published = datePublished or site.datePublished -%}
{%- set modified = dateModified or site.dateModified -%}
{%- set pageTitle = title if title and title != "Home" else (site.name + " – " + site.tagline) -%}
{%- set pageDescription = description or site.descriptionShort -%}
{%- set isHome = page.url == "/" -%}
{%- set isAiuti = page.url == "/aiuti-stato/" -%}
{# Core entity graph #}
<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": ["Organization", "ProfessionalService"],
      "@id": {{ orgId | dump | safe }},
      "name": {{ site.name | dump | safe }},
      "legalName": {{ site.legalName | dump | safe }},
      "url": {{ site.url | dump | safe }},
      "logo": {
        "@type": "ImageObject",
        "url": {{ site.logo | dump | safe }}
      },
      "image": {{ site.logo | dump | safe }},
      "description": {{ site.description | dump | safe }},
      "email": {{ site.email | dump | safe }},
      "telephone": {{ site.telephone | dump | safe }},
      "foundingDate": {{ site.foundingDate | dump | safe }},
      "vatID": {{ site.vatID | dump | safe }},
      "taxID": {{ site.taxID | dump | safe }},
      "priceRange": {{ site.priceRange | dump | safe }},
      "knowsAbout": {{ site.knowsAbout | dump | safe }},
      "sameAs": {{ site.sameAs | dump | safe }},
      "areaServed": [
        {%- for area in site.areaServed -%}
        { "@type": "Place", "name": {{ area | dump | safe }} }{% if not loop.last %},{% endif %}
        {%- endfor -%}
      ],
      "address": {
        "@type": "PostalAddress",
        "streetAddress": {{ site.officeAddress.streetAddress | dump | safe }},
        "addressLocality": {{ site.officeAddress.addressLocality | dump | safe }},
        "addressRegion": {{ site.officeAddress.addressRegion | dump | safe }},
        "postalCode": {{ site.officeAddress.postalCode | dump | safe }},
        "addressCountry": {{ site.officeAddress.addressCountry | dump | safe }}
      },
      "location": {
        "@type": "PostalAddress",
        "streetAddress": {{ site.legalAddress.streetAddress | dump | safe }},
        "addressLocality": {{ site.legalAddress.addressLocality | dump | safe }},
        "addressRegion": {{ site.legalAddress.addressRegion | dump | safe }},
        "postalCode": {{ site.legalAddress.postalCode | dump | safe }},
        "addressCountry": {{ site.legalAddress.addressCountry | dump | safe }}
      },
      "contactPoint": {
        "@type": "ContactPoint",
        "contactType": "sales",
        "email": {{ site.email | dump | safe }},
        "telephone": {{ site.telephone | dump | safe }},
        "availableLanguage": {{ site.languages | dump | safe }}
      },
      "makesOffer": [
        {%- for service in site.services -%}
        {
          "@type": "Offer",
          "itemOffered": {
            "@type": "Service",
            "name": {{ service.name | dump | safe }},
            "description": {{ service.description | dump | safe }},
            "provider": { "@id": {{ orgId | dump | safe }} }
          }
        }{% if not loop.last %},{% endif %}
        {%- endfor -%}
      ]
    },
    {
      "@type": "WebSite",
      "@id": {{ websiteId | dump | safe }},
      "url": {{ site.url | dump | safe }},
      "name": {{ site.name | dump | safe }},
      "description": {{ site.descriptionShort | dump | safe }},
      "inLanguage": "en",
      "datePublished": {{ site.datePublished | dump | safe }},
      "dateModified": {{ site.dateModified | dump | safe }},
      "publisher": { "@id": {{ orgId | dump | safe }} }
    },
    {
      "@type": "WebPage",
      "@id": {{ pageId | dump | safe }},
      "url": {{ pageUrl | dump | safe }},
      "name": {{ pageTitle | dump | safe }},
      "description": {{ pageDescription | dump | safe }},
      "isPartOf": { "@id": {{ websiteId | dump | safe }} },
      "about": { "@id": {{ orgId | dump | safe }} },
      "datePublished": {{ published | dump | safe }},
      "dateModified": {{ modified | dump | safe }},
      "inLanguage": {% if isAiuti %}"it"{% else %}"en"{% endif %},
      "primaryImageOfPage": {
        "@type": "ImageObject",
        "url": {{ site.logo | dump | safe }}
      }
      {%- if isHome -%}
      ,"speakable": {
        "@type": "SpeakableSpecification",
        "cssSelector": ["#hero h1", "#hero p", "#aeo-faq", "#aeo-howto"]
      },
      "mainEntity": { "@id": {{ orgId | dump | safe }} }
      {%- endif -%}
    },
    {
      "@type": "BreadcrumbList",
      "@id": {{ (pageUrl + "#breadcrumb") | dump | safe }},
      "itemListElement": [
        {
          "@type": "ListItem",
          "position": 1,
          "name": "Home",
          "item": {{ site.url | dump | safe }}
        }
        {%- if not isHome -%}
        ,{
          "@type": "ListItem",
          "position": 2,
          "name": {{ pageTitle | dump | safe }},
          "item": {{ pageUrl | dump | safe }}
        }
        {%- endif -%}
      ]
    }
  ]
}
</script>

{# Standalone root @type scripts — many AEO scanners only detect these #}
<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "Article",
  "@id": {{ (pageUrl + "#article") | dump | safe }},
  "headline": {{ pageTitle | dump | safe }},
  "description": {{ pageDescription | dump | safe }},
  "url": {{ pageUrl | dump | safe }},
  "image": {{ site.logo | dump | safe }},
  "datePublished": {{ published | dump | safe }},
  "dateModified": {{ modified | dump | safe }},
  "inLanguage": {% if isAiuti %}"it"{% else %}"en"{% endif %},
  "author": {
    "@type": "Organization",
    "name": {{ site.legalName | dump | safe }},
    "url": {{ site.url | dump | safe }}
  },
  "publisher": {
    "@type": "Organization",
    "name": {{ site.legalName | dump | safe }},
    "logo": {
      "@type": "ImageObject",
      "url": {{ site.logo | dump | safe }}
    }
  },
  "mainEntityOfPage": {
    "@type": "WebPage",
    "@id": {{ pageId | dump | safe }}
  }
}
</script>

{%- if isHome %}
<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "@id": {{ (site.url + "/#faq") | dump | safe }},
  "url": {{ (site.url + "/#aeo-faq") | dump | safe }},
  "name": "Frequently asked questions about Incode",
  "description": "Answers about Incode's services, technologies, e-commerce and Drupal work, white-label partnerships, UX research and support.",
  "inLanguage": "en",
  "isPartOf": { "@id": {{ websiteId | dump | safe }} },
  "about": { "@id": {{ orgId | dump | safe }} },
  "publisher": { "@id": {{ orgId | dump | safe }} },
  "datePublished": {{ site.datePublished | dump | safe }},
  "dateModified": {{ site.dateModified | dump | safe }},
  "mainEntity": [
    {%- for item in faq.items -%}
    {
      "@type": "Question",
      "@id": {{ (site.url + "/#faq-" + item.id) | dump | safe }},
      "url": {{ (site.url + "/#faq-" + item.id) | dump | safe }},
      "name": {{ item.question | dump | safe }},
      "acceptedAnswer": {
        "@type": "Answer",
        "text": {{ item.answer | dump | safe }},
        "url": {{ (site.url + "/#faq-" + item.id) | dump | safe }},
        "author": { "@id": {{ orgId | dump | safe }} }
      }
    }{% if not loop.last %},{% endif %}
    {%- endfor -%}
  ]
}
</script>
<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "HowTo",
  "@id": {{ (site.url + "/#howto") | dump | safe }},
  "name": "How to start a project with Incode",
  "description": "Simple steps to begin a website, e-commerce or custom software project with Incode.",
  "datePublished": {{ site.datePublished | dump | safe }},
  "dateModified": {{ site.dateModified | dump | safe }},
  "totalTime": "P3D",
  "step": [
    {
      "@type": "HowToStep",
      "position": 1,
      "name": "Share your idea",
      "text": "Email info@incode.it with your product idea, goals and timeline."
    },
    {
      "@type": "HowToStep",
      "position": 2,
      "name": "Align on scope",
      "text": "We review requirements together and define UX, technology stack and delivery plan."
    },
    {
      "@type": "HowToStep",
      "position": 3,
      "name": "Build and iterate",
      "text": "We design, develop and ship websites, e-commerce or custom full-stack products with you as a partner."
    }
  ]
}
</script>
{%- elif isAiuti %}
<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "@id": {{ (pageUrl + "#faq") | dump | safe }},
  "url": {{ pageUrl | dump | safe }},
  "datePublished": {{ published | dump | safe }},
  "dateModified": {{ modified | dump | safe }},
  "mainEntity": [
    {
      "@type": "Question",
      "name": "Cosa pubblica Incode Srl riguardo agli aiuti di Stato?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Come disposto dall’art. 1, comma 125, della L. 124/2017, Incode Srl espone gli importi relativi a sovvenzioni, contributi e vantaggi economici ricevuti dalle pubbliche amministrazioni."
      }
    },
    {
      "@type": "Question",
      "name": "Dove verificare gli aiuti di Incode Srl?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Gli aiuti sono consultabili nel Registro Nazionale degli Aiuti di Stato inserendo il codice fiscale 01357300191."
      }
    }
  ]
}
</script>
{%- endif %}
