<section id="hero" class="clearfix">
  <header class="hero__header px2">
    <h1 class="hero__title mb2">
      <span>
        <span class="hero__title--start">You think.</span>
        <span class="hero__typewrite"></span>
      </span>
    </h1>
    <div class="hero__content mx-auto">
      <p class="p1">We are an
        <strong>Italian</strong>
        <strong>creative</strong>
        <strong>studio</strong>
        specialising in
        <strong>full-stack development</strong>. Our clients are the main priority, but we
        <strong>love</strong>
        <strong>working</strong>
        <strong>with</strong>
        <strong>them</strong>, rather than for them.</p>
    </div>
    <div class="hero__cta mt3 sm-mt4">
      <a class="button" href="mailto:info@incode.it">Contact us</a>
    </div>
  </header>
  <div class="hero__toggle"></div>
</section>

<section id="latest-works" class="clearfix">
  <header class="section__header mt4 px2 center">
    <h2 class="section__title mb4">
      <span>Idea + Technology + Lean Design</span>
    </h2>
    <p class="section__description m0">Here's a random list of our works, <a href="javascript:location.reload()">refresh the page</a> to get more</a></p>
  </header>
  <div id="works-container">
    {%- for work in collections.works -%}
      <article class="work col-12 px2 relative clearfix mb4">
        <header class="work__header mt4 mb2 md-mb2 col-12 md-col-12 mx-auto">
          <h2 class="work__title">{{ work.data.title }}</h2>
          <span class="work__subtitle">{{ work.data.subtitle }}</span>
        </header>
        <div class="work__image--wrapper col-12 mx-auto relative xs-hide sm-hide">
          <a href="{{ work.data.portfolio_link }}" target="_blank">
            <img class="work__image fit" src="{{ work.data.image }}" alt="{{ work.data.title }}" loading="lazy">
          </a>
        </div>
        <div class="work__image--wrapper col-12 mx-auto relative md-hide lg-hide">
          <a href="{{ work.data.portfolio_link }}" target="_blank">
            <img class="work__image fit" src="{{ work.data.image_iphone }}" alt="{{ work.data.title }}" loading="lazy">
          </a>
        </div>
      </article>
    {%- endfor -%}
  </div>
</section>

<section id="we-make-things" class="clearfix">
  <header class="section__header mt4 md-px3">
    <h2 class="section__title col-12 md-col-10 px2 mb2 md-px0 mx-auto" style="transform: matrix(1, 0, 0, 1, 0, 0);">
      <span>We make things.</span>
    </h2>
  </header>
  <article class="section__content col-12 md-px3 relative clearfix my4">
    <div class="col-12 px2 md-px0 md-col-10 mx-auto relative">
      <div class="col col-12 mb4">
        <h3>
          Tell us your idea.<br>
          If it exists, we’ll make it for you.<br>
           If it doesn’t, we’ll make it up.
        </h3>
        <p>Incode is a full-stack web development and design studio. We build websites, e-commerce platforms and custom software, and we design the user experience around them — from research to interface.</p>
      </div>

      <div class="col col-12 lg-col-4 mb4 lg-pr2">
        <h3>Websites, CMS &amp; e-commerce</h3>
        <ul>
          <li>Corporate websites and editorial portals</li>
          <li>CMS, headless CMS and e-commerce</li>
          <li>Multisite, multilingual and multi-vendor platforms</li>
          <li>B2B and B2C shops, product configurators</li>
          <li>Loyalty, pricing rules and ERP integration</li>
        </ul>
        <p><strong>Technologies:</strong> WordPress, WooCommerce, Drupal, Shopify</p>
      </div>

      <div class="col col-12 lg-col-4 mb4 lg-pr2">
        <h3>Custom full-stack development</h3>
        <ul>
          <li>Full-stack development and custom projects on Ruby on Rails and Node</li>
          <li>JAMstack and static-site development</li>
          <li>API-first content and systems/API integration</li>
          <li>Technical architecture and tech leading</li>
          <li>Continuous deployment, hosting and maintenance on Netlify</li>
        </ul>
        <p><strong>Technologies:</strong> Ruby on Rails, Node.js, Vue.js, Astro, Eleventy, Netlify</p>
      </div>

      <div class="col col-12 lg-col-4 mb4">
        <h3>UX &amp; UI design</h3>
        <ul>
          <li>UI and UX design</li>
          <li>User research, personas and use cases</li>
          <li>Information architecture and wireframing</li>
          <li>UI design for web, apps and smart TV</li>
          <li>Heuristic and moderated testing with real users</li>
        </ul>
      </div>
    </div>
  </article>
</section>

