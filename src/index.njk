---
layout: layout1
title: Home
permalink: '/'
---

<section id="hero" class="relative min-h-screen">
  <header class="absolute top-1/2 left-1/2 w-full -translate-x-1/2 -translate-y-1/2 px-4 text-center">
    <h1 class="mb-4 text-[2.8rem] leading-[1.2] whitespace-normal phone:text-[4rem] phone:whitespace-nowrap tablet:text-[6rem] tablet:leading-none">
      <span>
        <span class="block phone:inline">You think.</span>
        <span class="hero__typewrite"></span>
      </span>
    </h1>
    <div class="mx-auto max-w-[54rem] text-[1.8rem]">
      <p class="m-0 p-0">We are an
        <strong>Italian</strong>
        <strong>creative</strong>
        <strong>studio</strong>
        specialising in
        <strong>full-stack development</strong>. Our clients are the main priority, but we
        <strong>love</strong>
        <strong>working</strong>
        <strong>with</strong>
        <strong>them</strong>, rather than for them.</p>
    </div>
    <div class="mt-8 sm:mt-16">
      <a class="button" href="mailto:info@incode.it">Contact us</a>
    </div>
  </header>
  <div class="animate-bounce-hero absolute bottom-12 left-[calc(50%-1px)] z-0 h-12 w-0.5 bg-white/30" aria-hidden="true"></div>
</section>

<section id="latest-works">
  <header class="mt-16 px-4 text-center">
    <h2 class="mb-16 text-[1.8rem] leading-[1.2] phone:text-[2.6rem] phone:leading-none">
      <span>Idea + Technology + Lean Design</span>
    </h2>
    <p class="m-0 text-[1.25rem] phone:text-[1.5rem] [&_a]:text-white">Here's a random list of our works, <a href="/" onclick="location.reload(); return false;">refresh the page</a> to get more</p>
  </header>
  <div id="works-container">
    {%- for work in collections.works -%}
      <article class="work mb-16 w-full px-4">
        <header class="mx-auto mt-16 mb-4 w-full">
          <h3 class="text-[1.8rem] font-normal">{{ work.data.title }}</h3>
          <span>{{ work.data.subtitle }}</span>
        </header>
        <div class="mx-auto hidden w-full md:block">
          <a href="{{ work.data.portfolio_link }}" target="_blank" rel="noopener noreferrer">
            <img class="w-full" src="/{{ work.data.image }}" alt="{{ work.data.title }}" width="2127" height="1065" loading="lazy" decoding="async">
          </a>
        </div>
        <div class="mx-auto block w-full md:hidden">
          <a href="{{ work.data.portfolio_link }}" target="_blank" rel="noopener noreferrer">
            <img class="w-full" src="/{{ work.data.image_iphone }}" alt="{{ work.data.title }}" width="909" height="1232" loading="lazy" decoding="async">
          </a>
        </div>
      </article>
    {%- endfor -%}
  </div>
</section>

<section id="we-make-things">
  <header class="mt-16 md:px-8">
    <h2 class="mx-auto mb-4 w-full px-4 text-[1.8rem] leading-[1.2] md:w-5/6 md:px-0 phone:text-[2.6rem] phone:leading-none">
      <span>We make things.</span>
    </h2>
  </header>
  <article class="my-16 w-full md:px-8">
    <div class="mx-auto grid w-full grid-cols-1 gap-4 px-4 md:w-5/6 md:px-0 lg:grid-cols-2">
      <div class="mb-16 w-full">
        <h3 class="text-[1.8rem] font-normal">
          Tell us your idea.<br>
          If it exists, we’ll make it for you.<br>
           If it doesn’t, we’ll make it up.
        </h3>
      </div>
      <div class="w-full">
        <div class="mb-6">
          <h3 class="text-[1.8rem] font-normal">Websites, E-commerce</h3>
          <p class="text-[1.2rem]">WordPress, WooCommerce, Drupal, Shopify</p>
        </div>
        <div class="mb-6"> 
          <h3 class="text-[1.8rem] font-normal">Custom projects</h3>
          <p class="text-[1.2rem]">Ruby/Rails, Node, Vue, architecture and integration</p>
        </div>
        <div class="mb-6">
          <h3 class="text-[1.8rem] font-normal">UX, UI</h3>
          <p class="text-[1.2rem]">Design, evaluation, assessment and consulting</p>
        </div>
      </div>
    </div>
  </article>
</section>
