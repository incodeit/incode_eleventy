<section id="hero" class="min-h-screen">
  <header class="absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 text-center w-full px-4">
    <h1 class="text-[6rem] whitespace-nowrap max-[990px]:text-[4rem] max-[990px]:leading-[1.2] max-[650px]:text-[2.8rem] max-[650px]:leading-[1.2] max-[650px]:whitespace-normal mb-4">
      <span>
        <span class="max-[650px]:block">You think.</span>
        <span class="hero__typewrite"></span>
      </span>
    </h1>
    <div class="text-[1.8rem] max-w-[54rem] max-[650px]:text-[1.4rem] mx-auto">
      <p class="m-0">We are an
        <strong>Italian</strong>
        <strong>creative</strong>
        <strong>studio</strong>
        specialising in
        <strong>full-stack development</strong>. Our clients are the main priority, but we
        <strong>love</strong>
        <strong>working</strong>
        <strong>with</strong>
        <strong>them</strong>, rather than for them.</p>
    </div>
    <div class="mt-8 sm:mt-16">
      <a class="button" href="mailto:info@incode.it">Contact us</a>
    </div>
  </header>
  <div class="hero__toggle"></div>
</section>

<section id="latest-works">
  <header class="mt-16 px-4 text-center">
    <h2 class="relative mb-16">
      <span>Idea + Technology + Lean Design</span>
    </h2>
    <p class="text-[1.5rem] max-[650px]:text-[1.25rem] m-0">Here's a random list of our works, <a class="text-white" href="javascript:location.reload()">refresh the page</a> to get more</a></p>
  </header>
  <div id="works-container">
    {%- for work in collections.works -%}
      <article class="work w-full px-4 relative mb-16">
        <header class="mt-16 mb-4 w-full mx-auto">
          <h2 class="text-[1.8rem] font-normal max-[650px]:text-[1.4rem]">{{ work.data.title }}</h2>
          <span>{{ work.data.subtitle }}</span>
        </header>
        <div class="w-full mx-auto relative hidden md:block">
          <a href="{{ work.data.portfolio_link }}" target="_blank">
            <img class="max-w-full" src="{{ work.data.image }}" alt="{{ work.data.title }}" loading="lazy">
          </a>
        </div>
        <div class="w-full mx-auto relative block md:hidden">
          <a href="{{ work.data.portfolio_link }}" target="_blank">
            <img class="max-w-full" src="{{ work.data.image_iphone }}" alt="{{ work.data.title }}" loading="lazy">
          </a>
        </div>
      </article>
    {%- endfor -%}
  </div>
</section>

<section id="we-make-things">
  <header class="mt-16 md:px-8">
