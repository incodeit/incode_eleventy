{
  "name": "incode_eleventy",
  "version": "0.1.0",
  "description": "incode website, w/ 11ty",
  "source": "src/index.html",
  "browserslist": "> 0.5%, last 2 versions, not dead",
  "scripts": {
    "start": "run-p serve:eleventy watch:parcel",
    "serve:eleventy": "cross-env ELEVENTY_ENV=local eleventy --serve",
    "watch:parcel": "run-p watch:css watch:js watch:images",
    "watch:css": "parcel watch ./src/css/index.css --dist-dir ./dist/css",
    "watch:js": "parcel watch ./src/js/main.js --dist-dir ./dist",
    "watch:images": "parcel watch ./src/img/*",
    "build": "run-s clean build:eleventy build:parcel",
    "build:eleventy": "cross-env ELEVENTY_ENV=production eleventy",
    "build:parcel": "run-s build:images build:css build:js",
    "build:css": "parcel build ./src/css/index.css --dist-dir ./dist/css",
    "build:js": "parcel build ./src/js/main.js --dist-dir ./dist",
    "build:images": "parcel build src/assets/img/* --dist-dir ./dist/assets/img",
    "clean": "rm -rf dist .parcel-cache",
    "deploy": "npm run build && gh-pages -d dist"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/incodeit/incode_eleventy.git"
  },
  "keywords": [],
  "author": "incode <info@incode.it>",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/incodeit/incode_eleventy/issues"
  },
  "homepage": "https://github.com/incodeit/incode_eleventy#readme",
  "devDependencies": {
    "@11ty/eleventy": "^1.0.0",
    "@tailwindcss/postcss": "^4.3.3",
    "autoprefixer": "^10.4.2",
    "cross-env": "^7.0.3",
    "gh-pages": "4.0.0",
    "html-minifier": "^4.0.0",
    "npm-run-all": "^4.1.5",
    "nunjucks": "^3.2.3",
    "parcel": "^2.2.1",
    "postcss": "^8.4.5",
    "tailwindcss": "^4.3.3"
  },
  "dependencies": {
    "@fontsource/kumbh-sans": "^5.3.0",
    "typed.js": "^2.0.12"
  }
}
